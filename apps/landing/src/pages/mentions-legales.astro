---
import LegalLayout from "../layouts/LegalLayout.astro";
import { legalConfig } from "../config/site.config";

const value = (input: string | null) => input ?? legalConfig.pendingValue;
---

<LegalLayout
  title="Mentions légales | ACREA Fitness"
  description="Mentions légales du site ACREA Fitness."
>
  <h1>Mentions légales</h1>

  <section>
    <h2>Éditeur du site</h2>
    <dl>
      <div><dt>Éditeur</dt><dd>{value(legalConfig.publisher.name)}</dd></div>
      <div><dt>Adresse de domiciliation</dt><dd>{value(legalConfig.publisher.registeredOffice)}</dd></div>
      <div><dt>Directeur de la publication</dt><dd>{value(legalConfig.publisher.publicationDirector)}</dd></div>
    </dl>
  </section>

  <section>
    <h2>Hébergement</h2>
    <p>
      Le site est hébergé sur Cloudflare Pages par <a href={legalConfig.host.website}>Cloudflare, Inc.</a>,
      {" "}{legalConfig.host.address}. Téléphone : {legalConfig.host.phone}.
    </p>
  </section>

  <section>
    <h2>Contact</h2>
    <p>
      Pour toute demande liée au site ou aux données personnelles, contactez
      {" "}{value(legalConfig.publisher.privacyContact)}.
    </p>
  </section>

  <section>
    <h2>Propriété intellectuelle</h2>
    <p>
      Les éléments publiés sur ce site, notamment les textes, marques, visuels,
      logos et éléments graphiques, sont protégés. Toute reproduction ou
      représentation non autorisée est interdite, sauf disposition légale contraire.
    </p>
  </section>
</LegalLayout>

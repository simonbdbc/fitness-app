---
import {
    Activity,
    ArrowRight,
    BrainCircuit,
    ChevronRight,
    Dumbbell,
    HeartPulse,
    Menu,
    MessageSquareCheck,
    ShieldCheck,
    SlidersHorizontal,
    Timer,
    Volume2,
    WifiOff,
    X,
} from "@lucide/astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteFooter from "../components/SiteFooter.astro";
import {
    aiFlow,
    features,
    pillars,
    siteConfig,
    steps,
} from "../config/site.config";

const appHomeHref = new URL(
    siteConfig.app.homePath,
    siteConfig.app.baseUrl,
).toString();
const loginHref = new URL(
    siteConfig.app.loginPath ?? siteConfig.app.homePath,
    siteConfig.app.baseUrl,
).toString();
const pillarIcons = [Dumbbell, HeartPulse, Activity];
const featureIcons = [Timer, Volume2, MessageSquareCheck, WifiOff];
const aiIcons = [SlidersHorizontal, BrainCircuit, ShieldCheck];
---

<BaseLayout>
    <a class="skip-link" href="#contenu">Aller au contenu</a>

    <header class="site-header" aria-label="Navigation principale">
        <div class="header-inner">
            <a class="brand" href="/" aria-label="ACREA Fitness, accueil">
                <img
                    src="/icons/acrea-icon-64.png"
                    alt=""
                    width="36"
                    height="36"
                />
                <span>ACREA <strong>Fitness</strong></span>
            </a>

            <nav class="desktop-nav" aria-label="Sections principales">
                {
                    siteConfig.navigation.map((item) => (
                        <a href={item.href}>{item.label}</a>
                    ))
                }
            </nav>

            <a class="header-cta" href={loginHref} data-cta="login">
                {siteConfig.cta.loginLabel}
            </a>

            <details class="mobile-menu">
                <summary aria-label="Ouvrir le menu">
                    <Menu class="menu-open" aria-hidden="true" size={23} />
                    <X class="menu-close" aria-hidden="true" size={23} />
                </summary>
                <nav aria-label="Menu mobile">
                    {
                        siteConfig.navigation.map((item) => (
                            <a href={item.href}>
                                {item.label}
                                <ChevronRight aria-hidden="true" size={18} />
                            </a>
                        ))
                    }
                    <a href={loginHref} data-cta="mobile-login">
                        {siteConfig.cta.loginLabel}
                        <ChevronRight aria-hidden="true" size={18} />
                    </a>
                </nav>
            </details>
        </div>
    </header>

    <main id="contenu">
        <section class="hero" aria-labelledby="hero-title">
            <picture class="hero-media">
                <source
                    type="image/avif"
                    srcset="/images/hero-push-up-640.avif 640w, /images/hero-push-up-1024.avif 1024w, /images/hero-push-up-1600.avif 1600w"
                    sizes="100vw"
                />
                <source
                    type="image/webp"
                    srcset="/images/hero-push-up-640.webp 640w, /images/hero-push-up-1024.webp 1024w, /images/hero-push-up-1600.webp 1600w"
                    sizes="100vw"
                />
                <img
                    src="/images/hero-push-up-1600.webp"
                    alt="Athlète réalisant une pompe dans un studio d'entraînement"
                    width="1600"
                    height="901"
                    fetchpriority="high"
                    decoding="async"
                />
            </picture>

            <div class="hero-inner page-shell">
                <div class="hero-copy">
                    <h1 id="hero-title"><span>ACREA</span> Fitness</h1>
                    <p>
                        Votre semaine d'entraînement au poids du corps,
                        structurée autour de 3 piliers : renforcement
                        musculaire, cardio et proprioception.
                    </p>
                    <div
                        class="hero-actions"
                        aria-label="Accès à l'application"
                    >
                        <a
                            class="button button-primary"
                            href={loginHref}
                            data-cta="primary"
                        >
                            {siteConfig.cta.primaryLabel}
                            <ArrowRight aria-hidden="true" size={19} />
                        </a>
                    </div>
                </div>
            </div>
        </section>

        <section
            id="acrea"
            class="section acronym-section"
            aria-labelledby="acrea-title"
        >
            <div class="page-shell">
                <div class="section-intro section-intro-row">
                    <p class="section-index">LA METHODE ACREA</p>
                    <h2 id="acrea-title">
                        Une séance complète,<br />en cinq temps.
                    </h2>
                    <p>
                        L'activation prépare l'effort et les assouplissements le
                        terminent. Entre les deux, les trois piliers se
                        combinent dans chaque séance.
                    </p>
                </div>

                <figure class="acronym-graphic">
                    <picture>
                        <source
                            type="image/avif"
                            srcset="/images/acrea-method-640.avif 640w, /images/acrea-method-1024.avif 1024w, /images/acrea-method-1600.avif 1600w"
                            sizes="(max-width: 700px) calc(100vw - 36px), (max-width: 1260px) calc(100vw - 96px), 1220px"
                        />
                        <source
                            type="image/webp"
                            srcset="/images/acrea-method-640.webp 640w, /images/acrea-method-1024.webp 1024w, /images/acrea-method-1600.webp 1600w"
                            sizes="(max-width: 700px) calc(100vw - 36px), (max-width: 1260px) calc(100vw - 96px), 1220px"
                        />
                        <img
                            src="/images/acrea-method-1600.webp"
                            alt="Méthode ACREA : activation et assouplissements encadrent les piliers cardio, renforcement musculaire et équilibre-proprioception."
                            width="1672"
                            height="941"
                            loading="lazy"
                            decoding="async"
                        />
                    </picture>
                    <figcaption>
                        <span class="sr-only">
                            A pour activation et échauffements ; C pour cardio ;
                            R pour renforcement musculaire ; E pour équilibre et
                            proprioception ; A pour assouplissements et
                            étirements.
                        </span>
                    </figcaption>
                </figure>
            </div>
        </section>

        <section
            id="methode"
            class="section pillars-section"
            aria-labelledby="pillars-title"
        >
            <div class="page-shell">
                <div class="section-intro section-intro-row">
                    <div>
                        <h2 id="pillars-title">
                            Trois piliers.<br />Une progression équilibrée.
                        </h2>
                    </div>
                    <p>
                        La méthode ACREA assemble les qualités physiques
                        essentielles dans un parcours hebdomadaire lisible, sans
                        matériel imposé.
                    </p>
                </div>

                <div class="pillars-grid">
                    {
                        pillars.map((pillar, index) => {
                            const Icon = pillarIcons[index];
                            return (
                                <article class="pillar">
                                    <Icon
                                        aria-hidden="true"
                                        size={42}
                                        stroke-width={1.7}
                                    />
                                    <h3>{pillar.title}</h3>
                                    <p>{pillar.description}</p>
                                </article>
                            );
                        })
                    }
                </div>
            </div>
        </section>

        <section class="section week-section" aria-labelledby="week-title">
            <div class="page-shell week-layout">
                <div class="week-copy">
                    <h2 id="week-title">Votre semaine, sans détour.</h2>
                    <p>
                        Exemple d'une semaine d'entraînement générée pour un
                        profil, configuré sur trois séances et sans équipement.
                        Chaque séance combine les trois piliers, seule la
                        priorité change selon le jour.
                    </p>
                    <a
                        class="text-link"
                        href={appHomeHref}
                        data-cta="secondary"
                    >
                        {siteConfig.cta.secondaryLabel}
                        <ArrowRight aria-hidden="true" size={18} />
                    </a>
                </div>

                <figure class="weekly-program">
                    <picture>
                        <source
                            type="image/avif"
                            srcset="/images/weekly-program-480.avif 480w, /images/weekly-program-720.avif 720w, /images/weekly-program-940.avif 940w"
                            sizes="(max-width: 820px) min(100vw - 36px, 460px), (max-width: 1260px) 400px, 470px"
                        />
                        <source
                            type="image/webp"
                            srcset="/images/weekly-program-480.webp 480w, /images/weekly-program-720.webp 720w, /images/weekly-program-940.webp 940w"
                            sizes="(max-width: 820px) min(100vw - 36px, 460px), (max-width: 1260px) 400px, 470px"
                        />
                        <img
                            src="/images/weekly-program-940.webp"
                            alt="Tableau d'une semaine : séances de renforcement lundi, cardio mercredi et proprioception vendredi, avec récupération les autres jours."
                            width="941"
                            height="1672"
                            loading="lazy"
                            decoding="async"
                        />
                    </picture>
                </figure>
            </div>
        </section>

        <section
            id="intelligence"
            class="section intelligence-section"
            aria-labelledby="intelligence-title"
        >
            <div class="page-shell intelligence-layout">
                <div class="intelligence-copy">
                    <p class="section-index">IA ACREA</p>
                    <h2 id="intelligence-title">
                        Une IA encadrée par votre contexte.
                    </h2>
                    <p>
                        ACREA ne propose pas une séance au hasard. Le moteur de
                        programmation IA s'appuie sur les informations de votre
                        profil et applique des garde-fous explicites pour
                        construire votre semaine.
                    </p>
                </div>

                <ol class="ai-flow">
                    {
                        aiFlow.map((step, index) => {
                            const Icon = aiIcons[index];
                            return (
                                <li>
                                    <span
                                        class="ai-flow-number"
                                        aria-hidden="true"
                                    >
                                        0{index + 1}
                                    </span>
                                    <Icon
                                        aria-hidden="true"
                                        size={30}
                                        stroke-width={1.7}
                                    />
                                    <div>
                                        <h3>{step.title}</h3>
                                        <p>{step.description}</p>
                                    </div>
                                </li>
                            );
                        })
                    }
                </ol>
            </div>
        </section>

        <section
            id="fonctionnalites"
            class="section features-section"
            aria-labelledby="features-title"
        >
            <div class="page-shell">
                <div class="section-intro section-intro-row">
                    <div>
                        <h2 id="features-title">Guidé pendant l'effort.</h2>
                    </div>
                    <p>
                        Les outils de séance restent discrets et utiles : ils
                        donnent le rythme, signalent les transitions et
                        recueillent le ressenti final.
                    </p>
                </div>

                <div class="features-grid">
                    {
                        features.map((feature, index) => {
                            const Icon = featureIcons[index];
                            return (
                                <article class="feature">
                                    <Icon
                                        aria-hidden="true"
                                        size={40}
                                        stroke-width={1.7}
                                    />
                                    <div>
                                        <h3>{feature.title}</h3>
                                        <p>{feature.description}</p>
                                    </div>
                                </article>
                            );
                        })
                    }
                </div>
            </div>
        </section>

        <section
            id="application"
            class="section steps-section"
            aria-labelledby="steps-title"
        >
            <div class="page-shell">
                <div class="section-intro centered-intro">
                    <h2 id="steps-title">Commencer en trois étapes.</h2>
                </div>

                <ol class="steps-list">
                    {
                        steps.map((step) => (
                            <li>
                                <span class="step-number" aria-hidden="true">
                                    {step.number}
                                </span>
                                <h3>{step.title}</h3>
                                <p>{step.description}</p>
                            </li>
                        ))
                    }
                </ol>
            </div>
        </section>

        <section class="final-cta" aria-labelledby="final-cta-title">
            <picture class="final-cta-media">
                <source
                    type="image/avif"
                    srcset="/images/final-plank-640.avif 640w, /images/final-plank-1024.avif 1024w, /images/final-plank-1600.avif 1600w"
                    sizes="100vw"
                />
                <source
                    type="image/webp"
                    srcset="/images/final-plank-640.webp 640w, /images/final-plank-1024.webp 1024w, /images/final-plank-1600.webp 1600w"
                    sizes="100vw"
                />
                <img
                    src="/images/final-plank-1600.webp"
                    alt="Athlète maintenant une planche dans un studio d'entraînement"
                    width="1600"
                    height="800"
                    loading="lazy"
                    decoding="async"
                />
            </picture>
            <div class="page-shell final-cta-inner">
                <div>
                    <h2 id="final-cta-title">
                        Prêt à progresser à votre rythme ?
                    </h2>
                    <p>
                        Évaluez votre niveau et retrouvez votre première semaine
                        dans l'application.
                    </p>
                    <a
                        class="button button-primary"
                        href={loginHref}
                        data-cta="final"
                    >
                        {siteConfig.cta.primaryLabel}
                        <ArrowRight aria-hidden="true" size={19} />
                    </a>
                </div>
            </div>
        </section>
    </main>

    <SiteFooter />
</BaseLayout>

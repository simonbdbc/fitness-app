---
import { siteConfig } from "../config/site.config";
import "../styles/global.css";

const title = Astro.props.title ?? siteConfig.title;
const description = Astro.props.description ?? siteConfig.description;
const preloadHero = Astro.props.preloadHero ?? Astro.url.pathname === "/";
const canonicalUrl = new URL(Astro.url.pathname, siteConfig.baseUrl).toString();
const socialImageUrl = new URL(
  siteConfig.socialImagePath,
  siteConfig.baseUrl,
).toString();
const appHomeUrl = new URL(
  siteConfig.app.homePath,
  siteConfig.app.baseUrl,
).toString();
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": `${siteConfig.baseUrl}/#website`,
      url: `${siteConfig.baseUrl}/`,
      name: siteConfig.name,
      description,
      inLanguage: siteConfig.lang,
    },
    {
      "@type": "SoftwareApplication",
      "@id": `${siteConfig.baseUrl}/#application`,
      name: siteConfig.name,
      applicationCategory: "HealthApplication",
      operatingSystem: "Web",
      url: appHomeUrl,
      description,
      inLanguage: siteConfig.lang,
      image: socialImageUrl,
    },
  ],
};
---

<!doctype html>
<html lang={siteConfig.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <link rel="canonical" href={canonicalUrl} />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content={siteConfig.name} />
    <meta property="og:locale" content={siteConfig.locale} />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="Athlète en entraînement au poids du corps avec ACREA Fitness"
    />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />
    <meta
      name="twitter:image:alt"
      content="Athlète en entraînement au poids du corps avec ACREA Fitness"
    />

    <meta name="theme-color" content={siteConfig.themeColor} />
    <link rel="icon" type="image/png" sizes="32x32" href="/icons/favicon-32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/icons/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link
      rel="preload"
      href="/fonts/barlow-condensed-latin-800.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/inter-latin-400.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    {
      preloadHero && (
        <link
          rel="preload"
          href="/images/hero-push-up-1600.avif"
          as="image"
          type="image/avif"
          imagesrcset="/images/hero-push-up-640.avif 640w, /images/hero-push-up-1024.avif 1024w, /images/hero-push-up-1600.avif 1600w"
          imagesizes="100vw"
          fetchpriority="high"
        />
      )
    }
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </head>
  <body>
    <slot />
  </body>
</html>

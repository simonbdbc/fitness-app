---
import BaseLayout from "./BaseLayout.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { legalConfig } from "../config/site.config";

const { description, title } = Astro.props;
---

<BaseLayout title={title} description={description}>
  <a class="skip-link" href="#contenu">Aller au contenu</a>

  <header class="site-header legal-site-header">
    <div class="header-inner">
      <a class="brand" href="/" aria-label="ACREA Fitness, accueil">
        <img src="/icons/acrea-icon-64.png" alt="" width="36" height="36" />
        <span>ACREA <strong>Fitness</strong></span>
      </a>
      <a class="legal-return" href="/">Retour à l'accueil</a>
    </div>
  </header>

  <main id="contenu" class="legal-main">
    <article class="page-shell legal-content">
      <slot />
      <p class="legal-updated">Dernière mise à jour : {legalConfig.updatedAt}</p>
    </article>
  </main>

  <SiteFooter useHomepageAnchors />
</BaseLayout>

{
  "name": "acrea-fitness-landing",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "assets:build": "node scripts/prepare-assets.mjs",
    "build": "pnpm assets:build && ASTRO_TELEMETRY_DISABLED=1 astro build",
    "validate": "node scripts/validate-production-build.mjs",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview",
    "lighthouse:mobile": "lhci autorun --config=.lighthouserc.mobile.cjs",
    "lighthouse:desktop": "lhci autorun --config=.lighthouserc.desktop.cjs",
    "lighthouse:ci": "pnpm build && pnpm validate && pnpm lighthouse:mobile && pnpm lighthouse:desktop"
  },
  "dependencies": {
    "@lucide/astro": "^1.24.0",
    "astro": "^7.0.7"
  },
  "devDependencies": {
    "@fontsource/barlow-condensed": "^5.2.8",
    "@fontsource/inter": "^5.2.8",
    "@lhci/cli": "^0.15.1",
    "sharp": "^0.35.3"
  }
}

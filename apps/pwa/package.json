{
  "name": "fitness-client",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.7.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "node scripts/start-web.mjs",
    "seed:formats:generate": "node scripts/generate-base-format-seed.mjs",
    "seed:formats:check": "node scripts/generate-base-format-seed.mjs --check",
    "seed:catalog:generate": "node scripts/generate-catalog-foundation-seed.mjs",
    "seed:catalog:check": "node scripts/generate-catalog-foundation-seed.mjs --check",
    "seed:catalog:update-from-snapshot": "node scripts/update-catalog-seed-from-snapshot.mjs --input src/features/catalog/data/catalogSeed.json",
    "seed:catalog:update-from-snapshot:check": "node scripts/update-catalog-seed-from-snapshot.mjs --input src/features/catalog/data/catalogSeed.json --check",
    "seed:supabase-v2:generate": "node scripts/generate-supabase-v2-seed.mjs",
    "seed:supabase-v2:check": "node scripts/generate-supabase-v2-seed.mjs --check",
    "library:exercise:generate": "node scripts/generate-exercise-library.mjs",
    "library:exercise:check": "node scripts/generate-exercise-library.mjs --check && node scripts/check-exercise-library.mjs && node scripts/generate-exercise-library-supabase-seed.mjs --check",
    "library:exercise:supabase:generate": "node scripts/generate-exercise-library-supabase-seed.mjs",
    "library:exercise:supabase:check": "node scripts/generate-exercise-library-supabase-seed.mjs --check",
    "db:docs:check": "node scripts/validate-db-docs.mjs",
    "db:runtime:test": "node --test scripts/database-runtime-contract.test.mjs scripts/database-migrations-contract.test.mjs scripts/database-migrations-sqlite-real.test.mjs scripts/beta-supabase-migration-contract.test.mjs scripts/verify-catalog-progressive-schema.test.mjs scripts/verify-catalog-progressive-schema-local.test.mjs",
    "db:production-copy:prepare": "node scripts/prepare-anonymized-production-copy.mjs",
    "db:production-copy:validate": "node scripts/validate-anonymized-production-copy.mjs",
    "db:production-plan:verify": "node scripts/verify-production-migration-plan.mjs",
    "db:advisors:compare": "node scripts/compare-supabase-advisors.mjs",
    "catalog:remote:check": "node scripts/validate-remote-catalog.mjs",
    "catalog:progressive:preflight": "node scripts/verify-catalog-progressive-schema.mjs",
    "catalog:progressive:local": "node scripts/verify-catalog-progressive-schema-local.mjs",
    "catalog:boundary:test": "node --test scripts/catalog-boundary-contract.test.mjs",
    "architecture:test": "node --test scripts/architecture-boundary-contract.test.mjs",
    "component:test": "vitest run",
    "e2e:test": "playwright test",
    "e2e:test:build": "pnpm build:web && pnpm e2e:test",
    "auth:roles:check": "node scripts/validate-auth-roles.mjs",
    "generate:pwa-icons": "node scripts/generate-pwa-icons.mjs",
    "build:web": "pnpm library:exercise:check && node scripts/generate-pwa-icons.mjs && node scripts/export-web.mjs && node scripts/prepare-cloudflare-pages.mjs",
    "validate:pwa": "node scripts/validate-pwa.mjs",
    "pwa:contract:test": "node --test scripts/api-health-contract.test.mjs scripts/f5-session-persistence-contract.test.mjs scripts/pwa-lifecycle-contract.test.mjs",
    "auth:test": "node --test scripts/auth-session-contract.test.mjs scripts/auth-account-type-migration.test.mjs",
    "timer:test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test scripts/session-timer-machine.test.mjs",
    "tooling:check": "node scripts/validate-tooling-config.mjs",
    "typecheck": "pnpm tooling:check && pnpm library:exercise:check && tsc --noEmit",
    "backend:check": "cargo check --manifest-path ../../fitness-service/Cargo.toml",
    "ai:model:check": "cargo run --manifest-path ../../crates/weekly-ai-train/Cargo.toml -- --check",
    "ai:wasm:build": "node scripts/build-weekly-ai-wasm.mjs",
    "ai:wasm:test": "node --test scripts/weekly-ai-wasm.test.mjs",
    "ai:pwa:test": "node --test scripts/weekly-program-contract.test.mjs scripts/weekly-program-schedule.test.mjs scripts/exercise-progression.test.mjs scripts/level-test-protocol.test.mjs scripts/acrea-v3-format-recovery.test.mjs",
    "catalog:equipment:test": "node --test scripts/equipment-catalog.test.mjs",
    "ai:test": "pnpm ai:model:check && pnpm ai:wasm:test && pnpm ai:pwa:test && pnpm catalog:equipment:test"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@supabase/supabase-js": "^2.108.2",
    "expo": "~55.0.27",
    "expo-asset": "55.0.17",
    "expo-audio": "~55.0.15",
    "expo-crypto": "~55.0.16",
    "expo-image": "~55.0.11",
    "expo-keep-awake": "~55.0.8",
    "expo-router": "~55.0.14",
    "expo-secure-store": "~55.0.15",
    "expo-sqlite": "~55.0.17",
    "expo-status-bar": "~55.0.6",
    "nativewind": "^4.2.3",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.6",
    "react-native-css-interop": "0.2.6",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-svg": "15.15.3",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-web": "^0.21.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@playwright/test": "1.55.1",
    "@testing-library/jest-dom": "6.6.4",
    "@testing-library/react": "16.3.0",
    "@types/node": "26.0.0",
    "@types/react": "~19.2.10",
    "babel-plugin-module-resolver": "^5.0.3",
    "jsdom": "26.1.0",
    "supabase": "2.108.0",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.6.0",
    "vitest": "4.1.11"
  }
}

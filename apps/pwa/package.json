{
  "name": "fitness-client",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.7.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "node scripts/start-web.mjs",
    "library:exercise:generate": "node scripts/generate-exercise-library.mjs",
    "library:exercise:check": "node scripts/generate-exercise-library.mjs --check && node scripts/check-exercise-library.mjs",
    "build:web": "pnpm library:exercise:check && node scripts/generate-pwa-icons.mjs && node scripts/export-web.mjs && node scripts/prepare-demo-web.mjs",
    "validate:pwa": "node scripts/validate-pwa.mjs",
    "typecheck": "pnpm tooling:check && pnpm library:exercise:check && tsc --noEmit",
    "tooling:check": "node scripts/validate-tooling-config.mjs",
    "component:test": "vitest run",
    "test:demo": "node --test scripts/level-test-protocol.test.mjs scripts/session-timer-machine.test.mjs scripts/pwa-lifecycle-contract.test.mjs scripts/api-health-contract.test.mjs scripts/f5-session-persistence-contract.test.mjs scripts/demo-database.test.mjs",
    "e2e:test": "playwright test",
    "ai:wasm:build": "node scripts/build-weekly-ai-wasm.mjs"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@supabase/supabase-js": "^2.108.2",
    "expo": "~55.0.27",
    "expo-asset": "55.0.17",
    "expo-audio": "~55.0.15",
    "expo-crypto": "~55.0.16",
    "expo-image": "~55.0.11",
    "expo-keep-awake": "~55.0.8",
    "expo-router": "~55.0.14",
    "expo-secure-store": "~55.0.15",
    "expo-sqlite": "~55.0.17",
    "expo-status-bar": "~55.0.6",
    "nativewind": "^4.2.3",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.6",
    "react-native-css-interop": "0.2.6",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-svg": "15.15.3",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-web": "^0.21.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@playwright/test": "1.55.1",
    "@testing-library/jest-dom": "6.6.4",
    "@testing-library/react": "16.3.0",
    "@types/node": "26.0.0",
    "@types/react": "~19.2.10",
    "babel-plugin-module-resolver": "^5.0.3",
    "jsdom": "26.1.0",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.6.0",
    "vitest": "4.1.11"
  }
}

{
  "name": "acrea-fitness",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "setup": "pnpm --dir apps/pwa install --frozen-lockfile",
    "dev": "pnpm --dir apps/pwa web",
    "build": "pnpm --dir apps/pwa build:web",
    "preview": "pnpm --dir apps/pwa exec node scripts/serve-dist.mjs",
    "demo": "pnpm build && pnpm preview",
    "typecheck": "pnpm --dir apps/pwa typecheck",
    "test": "pnpm --dir apps/pwa test:demo",
    "e2e": "pnpm --dir apps/pwa e2e:test",
    "library:generate": "node scripts/audit-exercise-library-v2.mjs && pnpm --dir apps/pwa library:exercise:generate",
    "library:check": "node scripts/audit-exercise-library-v2.mjs --check && pnpm --dir apps/pwa library:exercise:check"
  }
}
